# ==============================================================================
# THE LAST SIGNAL — Environment Variables Template
# ==============================================================================
# Note: For Vite frontend client, only variables prefixed with VITE_ are exposed
# to the browser runtime via import.meta.env.
# 
# NEVER commit real credentials or .env / .env.local to version control.
# NEVER expose the SUPABASE_SERVICE_ROLE_KEY or database passwords in client code.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (Safe for browser use with Row-Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
